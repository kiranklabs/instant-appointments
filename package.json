{
  "name": "lumen-mcp",
  "version": "1.0.0",
  "description": "Lumen Hair Studio MCP Connector v1 — sample booking flow over streamable HTTP",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
